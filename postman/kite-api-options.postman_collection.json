                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"underlying\": \"NIFTY\",\n  \"optionTypes\": [\"CE\", \"PE\"],\n  \"timeframes\": [\"ONE_MINUTE\", \"FIVE_MINUTE\"],\n  \"to\": \"2026-04-15\",\n  \"windows\": [\n    { \"name\": \"1-year\", \"from\": \"2025-04-15\", \"to\": \"2026-04-15\" }\n  ]\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/backtest/analyze-pruned-120k",
                                                      "description":  "Parallel 120k validation run. Uses totalCapital 120000 variants for stop-12-target-24, target-25, and risk-1.5 across the same one-year CE/PE and 1m/5m buckets. This does not change the live 60k config."
                                                  }
