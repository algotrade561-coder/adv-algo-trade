                 {
                     "name":  "Data Maintenance",
                     "item":  [
                                  {
                                      "name":  "Append Zerodha Options To Global Dataset - Dry Run",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                  "raw":  "{\n  \"underlying\": \"NIFTY\",\n  \"timeframe\": \"ONE_MINUTE\",\n  \"outputRoot\": \"C:/data/backtest/imports/global-datafeeds\",\n  \"from\": \"2026-04-16\",\n  \"to\": \"2026-04-17\",\n  \"optionTypes\": [\"CE\", \"PE\"],\n  \"dryRun\": true\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/data-maintenance/append-zerodha-options",
                                                      "description":  "Resolves the missing append date range and nearest-expiry NIFTY CE/PE option instruments without downloading Zerodha historical candles or writing files. Strike bounds are intentionally omitted so the maintenance run accumulates the full selected expiry chain, similar to the converted Global Datafeeds dataset."
                                                  }
                                  },
                                  {
                                      "name":  "Append Zerodha Options To Global Dataset",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                  "raw":  "{\n  \"underlying\": \"NIFTY\",\n  \"timeframe\": \"ONE_MINUTE\",\n  \"outputRoot\": \"C:/data/backtest/imports/global-datafeeds\",\n  \"from\": \"2026-04-16\",\n  \"to\": \"2026-04-17\",\n  \"optionTypes\": [\"CE\", \"PE\"],\n  \"dryRun\": false\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/data-maintenance/append-zerodha-options",
                                                      "description":  "Explicit maintenance call to append Zerodha historical option candles after the latest existing Global Datafeeds by-day file. Writes to by-day and by-contract with duplicate timestamp/instrument protection. Strike bounds are intentionally omitted so the maintenance run accumulates the full selected expiry chain, similar to the converted Global Datafeeds dataset."
                                                  }
                                  }
                              ]
