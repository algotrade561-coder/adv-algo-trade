                                                                   "raw":  "{\n  \"underlying\": \"NIFTY\",\n  \"optionTypes\": [\"CE\", \"PE\"],\n  \"timeframes\": [\"ONE_MINUTE\", \"FIVE_MINUTE\"],\n  \"to\": \"2026-04-15\",\n  \"windows\": [\n    { \"name\": \"1-year\", \"from\": \"2025-04-15\", \"to\": \"2026-04-15\" }\n  ]\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/backtest/analyze-pruned",
                                                      "description":  "Recommended next run. Uses the final pruned variant list from the completed suite analysis: stop-12-target-24, cap-30k-risk-1-5, and target-25. Produces the final suite-report.html with recommendations, bucket health, all variant details, settings, and weekly/monthly performance."
