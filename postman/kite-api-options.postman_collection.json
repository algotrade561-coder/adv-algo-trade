                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"underlying\": \"NIFTY\",\n  \"to\": \"2026-04-17\"\n}"
                                                               },
                                                      "url":  "{{baseUrl}}/backtest/analyze-weekend-intensive",
                                                      "description":  "Broad weekend validation matrix for the last clean trading date before Monday. Uses NIFTY CE/PE, ONE_MINUTE/FIVE_MINUTE, last-day through one-year windows, train-to-Mar31 and validate-Apr windows, and the full intensive variant set. The generated suite-report.html includes filterable and sortable tables plus all individual run rows."
                                                  }
