trading:
  mode: PAPER
  live-trading-enabled: false
  timezone: Asia/Kolkata
  broker:
    name: ZERODHA
    api-key: ${KITE_API_KEY:}
    api-secret: ${KITE_API_SECRET:}
    access-token: ${KITE_ACCESS_TOKEN:}
    user-id: ${KITE_USER_ID:}
    base-url: https://api.kite.trade
    login-url: https://kite.zerodha.com/connect/login
    redirect-url: ${KITE_REDIRECT_URL:http://localhost:8080/auth/kite/callback}
    callback-path: /auth/kite/callback
    request-timeout: 5s
  symbols:
    underlyings:
      - NIFTY
      - BANKNIFTY
    default-expiry: NEAREST_WEEKLY
  strike:
    selection-mode: ATM
    nearby-strikes: 5
  entry:
    timeframe: ONE_MINUTE
    trend-timeframe: FIVE_MINUTE
    vwap-filter-enabled: true
    trend-filter-enabled: false
    volume-spike-multiplier: 1.5
    breakout-buffer-percent: 0.1
    min-liquidity-volume: 10000
    max-iv-percent: 80
    entry-start-time: "09:25"
    entry-cutoff-time: "14:45"
    allow-first-minutes-entry: false
    no-entry-first-minutes: 10
  exit:
    stop-loss-percent: 10
    target-percent: 20
    trailing-stop-activation-percent: 12
    trailing-gap-percent: 6
    forced-exit-time: "15:15"
    partial-profit-booking-enabled: false
  risk:
    total-capital: 300000
    max-risk-per-trade-percent: 1
    max-daily-loss-percent: 3
    max-trades-per-day: 2
    max-consecutive-losses: 2
    one-open-trade-at-a-time: true
    cooldown-minutes: 10
  paper:
    slippage-percent: 0.05
    starting-cash: 300000
  safety:
    kill-switch-enabled: false
    stale-market-data-threshold: 10s
    broker-retry-count: 2
    broker-retry-backoff: 500ms
  backtest:
    from: 2025-01-01
    to: 2025-01-31
    candle-timeframe: ONE_MINUTE
    csv-import-path: data/backtest/input.csv
    output-directory: reports/backtest

spring:
  datasource:
    url: jdbc:h2:file:./data/kite-api-options;MODE=PostgreSQL;AUTO_SERVER=TRUE
    driver-class-name: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
  h2:
    console:
      enabled: true
      path: /h2-console

logging:
  level:
    com.kiteapioptions: INFO
