trading:
  mode: PAPER
  market-data-mode: MOCK
  execution-mode: PAPER
  live-trading-enabled: false
  timezone: Asia/Kolkata
  broker:
    name: ZERODHA
    base-url: https://api.kite.trade
    login-url: https://kite.zerodha.com/connect/login
    redirect-url: ${KITE_REDIRECT_URL:http://localhost:8081/auth/kite/callback}
    callback-path: /auth/kite/callback
    request-timeout: 5s
    auto-login-on-startup: true
  symbols:
    underlyings:
      - NIFTY
    default-expiry: NEAREST_WEEKLY
    spot-quote-keys:
      NIFTY: "NSE:NIFTY 50"
      BANKNIFTY: "NSE:NIFTY BANK"
    spot-historical-keys:
      NIFTY: "NSE:NIFTY 50"
      BANKNIFTY: "NSE:NIFTY BANK"
  strike:
    selection-mode: ATM
    nearby-strikes: 5
  entry:
    timeframe: FIVE_MINUTE
    trend-timeframe: FIVE_MINUTE
    enabled-option-types:
      - CE
      - PE
    vwap-filter-enabled: true
    trend-filter-enabled: false
    volume-spike-multiplier: 1.2
    breakout-buffer-percent: 0.05
    breakout-lookback: 15
    volume-lookback: 5
    bullish-imbalance-threshold: 1.2
    bearish-imbalance-threshold: 0.8
    min-liquidity-volume: 5000
    max-iv-percent: 80
    min-signal-score-percent: 70
    entry-start-time: "09:25"
    entry-cutoff-time: "14:45"
    allow-first-minutes-entry: false
    no-entry-first-minutes: 10
    rsi-filter-enabled: false
    rsi-period: 14
    rsi-ce-buy-threshold: 55
    rsi-pe-sell-threshold: 45
  exit:
    stop-loss-percent: 12
    target-percent: 24
    trailing-stop-activation-percent: 12
    trailing-gap-percent: 6
    forced-exit-time: "15:15"
    partial-profit-booking-enabled: false
    max-hold-minutes: 0
  risk:
    total-capital: 60000
    max-risk-per-trade-percent: 1
    max-daily-loss-percent: 3
    max-trades-per-day: 6
    max-orders-per-day: 6
    max-consecutive-losses: 2
    one-open-trade-at-a-time: true
    same-instrument-reentry-min-price-move-percent: 10
    cooldown-minutes: 10
  paper:
    slippage-percent: 0.05
    starting-cash: 300000
  safety:
    kill-switch-enabled: false
    stale-market-data-threshold: 10s
    broker-retry-count: 2
    broker-retry-backoff: 500ms
  telegram:
    request-timeout: 5s
  algo:
    scheduler-enabled: true
    scan-interval-ms: 60000
    initial-delay-ms: 5000
    candle-lookback: 30
    max-entries-per-scan: 1
    refresh-instruments-on-start: true
    auto-start-scanner-after-login: false
  backtest:
    from: 2025-01-01
    to: 2025-01-31
    candle-timeframe: ONE_MINUTE
    csv-import-path: C:/data/backtest/imports/input.csv
    output-directory: C:/data/backtest/results
    mock-instrument-key: NFO:NIFTY-MOCK-ATM-CE
    mock-candle-count: 180
    lot-size: 65

spring:
  config:
    import: optional:file:./data/trading-secrets.properties
  datasource:
    url: jdbc:h2:file:./data/kite-api-options;MODE=PostgreSQL;AUTO_SERVER=TRUE
    driver-class-name: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
  h2:
    console:
      enabled: true
      path: /h2-console

logging:
  level:
    com.kiteapioptions: INFO
