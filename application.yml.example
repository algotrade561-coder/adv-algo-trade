# ══════════════════════════════════════════════════════════════════════════
# AlgoTrader Pro — Example Configuration (PAPER mode, safe defaults)
# ══════════════════════════════════════════════════════════════════════════
# Copy to src/main/resources/application.yml and adjust as needed.
# Secrets go in data/trading-secrets.properties (git-ignored).

trading:
  mode: PAPER                   # PAPER | BACKTEST | LIVE
  market-data-mode: MOCK        # MOCK | ZERODHA
  execution-mode: PAPER         # PAPER | ZERODHA
  live-trading-enabled: false   # Must be true for real Zerodha orders
  timezone: Asia/Kolkata

  broker:
    name: ZERODHA
    base-url: https://api.kite.trade
    login-url: https://kite.zerodha.com/connect/login
    redirect-url: ${KITE_REDIRECT_URL:http://localhost:8089/advalgotrade/auth/kite/callback}
    callback-path: /auth/kite/callback
    request-timeout: 5s
    auto-login-on-startup: true
    ngrok-enabled: ${NGROK_ENABLED:false}
    ngrok-path: ${NGROK_PATH:ngrok}
    ngrok-http-port: ${NGROK_HTTP_PORT:8089}
    ngrok-config-path: ${NGROK_CONFIG_PATH:ngrok.yml}
    ngrok-callback-tunnel-name: app
    ngrok-ui-enabled: false
    ngrok-ui-http-port: ${NGROK_UI_HTTP_PORT:8089}
    ngrok-ui-tunnel-name: app

  symbols:
    underlyings:
      - NIFTY
    default-expiry: NEAREST_WEEKLY
    spot-quote-keys:
      NIFTY: "NSE:NIFTY 50"
      BANKNIFTY: "NSE:NIFTY BANK"
    spot-historical-keys:
      NIFTY: "NSE:NIFTY 50"
      BANKNIFTY: "NSE:NIFTY BANK"

  strike:
    selection-mode: ATM
    nearby-strikes: 5

  entry:
    timeframe: FIVE_MINUTE
    trend-timeframe: FIVE_MINUTE
    enabled-option-types:
      - CE
      - PE
    vwap-filter-enabled: true
    trend-filter-enabled: false
    volume-spike-multiplier: 1.2
    breakout-buffer-percent: 0.05
    breakout-lookback: 15
    volume-lookback: 5
    bullish-imbalance-threshold: 1.2
    bearish-imbalance-threshold: 0.8
    min-liquidity-volume: 5000
    max-iv-percent: 80
    min-signal-score-percent: 70
    ce-oi-support-required: false
    pe-oi-support-required: true
    ce-oi-divergence-filter-enabled: true
    pe-oi-divergence-filter-enabled: true
    oi-divergence-multiplier: 2.0
    oi-divergence-min-change: 100000
    ce-breakout-confirmation-candles: 1
    pe-breakout-confirmation-candles: 2
    entry-start-time: "09:25"
    entry-cutoff-time: "14:45"
    allow-first-minutes-entry: false
    no-entry-first-minutes: 10
    rsi-filter-enabled: false
    rsi-period: 14
    rsi-ce-buy-threshold: 55
    rsi-pe-sell-threshold: 45

  exit:
    stop-loss-percent: 12
    target-percent: 24
    trailing-stop-activation-percent: 10
    trailing-gap-percent: 5
    forced-exit-time: "15:15"
    partial-profit-booking-enabled: false
    max-hold-minutes: 0

  risk:
    total-capital: 60000
    max-risk-per-trade-percent: 5
    max-daily-loss-percent: 3
    max-trades-per-day: 4
    max-orders-per-day: 4
    max-consecutive-losses: 2
    max-open-trades: 1
    same-instrument-reentry-min-price-move-percent: 10
    cooldown-minutes: 10

  paper:
    slippage-percent: 0.05
    starting-cash: 30000

  safety:
    kill-switch-enabled: false
    stale-market-data-threshold: 10s
    broker-retry-count: 2
    broker-retry-backoff: 500ms

  telegram:
    request-timeout: 5s

  algo:
    scheduler-enabled: false
    scan-interval-ms: 60000
    initial-delay-ms: 5000
    candle-lookback: 30
    max-entries-per-scan: 1
    refresh-instruments-on-start: true
    auto-start-scanner-after-login: true

  backtest:
    from: 2025-01-01
    to: 2025-12-31
    candle-timeframe: ONE_MINUTE
    csv-import-path: C:/data/backtest/imports/input.csv
    output-directory: C:/data/backtest/results
    mock-instrument-key: NFO:NIFTY-MOCK-ATM-CE
    mock-candle-count: 180
    lot-size: 65

spring:
  config:
    import: optional:file:./data/trading-secrets.properties
  datasource:
    url: jdbc:h2:file:./data/adv-algo-trade;MODE=PostgreSQL;AUTO_SERVER=TRUE
    driver-class-name: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
  h2:
    console:
      enabled: true
      path: /h2-console

logging:
  level:
    com.algo.trade: INFO

# ── Algo Flow Orchestrator — pre-trade filter pipeline ─────────
algo-flow:
  vix-filter-enabled: true
  session-filter-enabled: true
  event-filter-enabled: true
  volume-activity-enabled: true
  pcr-filter-enabled: true

# VIX Regime thresholds
vix-regime:
  dead-threshold: 12.0
  extreme-threshold: 25.0
  direction-lookback-minutes: 15

# Session windows (IST)
session:
  morning-momentum-start: "09:16"
  morning-momentum-end: "09:45"
  midday-chop-start: "11:30"
  midday-chop-end: "13:00"
  pre-close-cutoff: "14:45"

# PCR sentiment thresholds
pcr-tracker:
  extreme-bullish: 0.5
  extreme-bearish: 1.5

server:
  port: 8089
  servlet:
    context-path: /advalgotrade
  forward-headers-strategy: framework
